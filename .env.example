# Copy to .env at the repo root and add your key. The example APIs (examples/demo_common/host.py)
# read this file, after the environment and the example's own .env; the SDK consoles and the
# MCP servers read the environment only. Never put a real key in this file.
ANTHROPIC_API_KEY=

# The retail example uses one pre-created Rebyte Agent. Keep its runtime values on
# the FastAPI server; the browser never receives them.
REBYTE_API_KEY=
REBYTE_AGENT_ID=
# REBYTE_BASE_URL=https://api.rebyte.ai

# The Rebyte CLI resolves this URL while creating the Agent.
STOREFRONT_MCP_URL=
