# Modified by ReByteAI in 2026 to integrate the Rebyte managed Agent API.
# Copy this file to .env. The FastAPI BFF reads the organization API key server-side;
# never expose it through a NEXT_PUBLIC_ variable or commit the completed file.
REBYTE_API_KEY=
# Set this after `rebyte agent create`.
REBYTE_AGENT_ID=
# Generate a random value with `openssl rand -hex 32`. The Rebyte Custom MCP connector
# presents it to the local MCP gateway as a Bearer token. Use at least 32 characters.
REBYTE_MCP_GATEWAY_TOKEN=
# REBYTE_BASE_URL=https://api.rebyte.ai
